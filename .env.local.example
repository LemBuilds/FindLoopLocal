# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public URL of the deployment, used in auth email links (e.g. https://findloop.vercel.app).
# Optional on Vercel — falls back to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string; Vercel Cron sends it as a Bearer token to /api/claims/expire.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=you@example.com
