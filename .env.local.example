# Create a free project at https://supabase.com and paste your credentials below
# Then copy this file to .env.local and fill in the values

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret used server-side only (from Project Settings > API > service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
